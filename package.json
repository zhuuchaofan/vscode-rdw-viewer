{
  "name": "rdw-viewer",
  "displayName": "RDW Viewer",
  "description": "查看带前后 4 字节小端序 RDW 的可变长记录文件，支持 COBOL copybook 按字段展示",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "rdwViewer.open",
        "title": "用 RDW Viewer 打开"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "rdwViewer.open",
          "when": "!explorerResourceIsFolder",
          "group": "navigation@100"
        }
      ],
      "commandPalette": [
        {
          "command": "rdwViewer.open",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "RDW Viewer",
      "properties": {
        "rdwViewer.encoding": {
          "type": "string",
          "default": "shift_jis",
          "description": "记录正文的默认字符编码（WHATWG 编码名，如 shift_jis、utf-8、euc-jp、gbk）。"
        },
        "rdwViewer.lengthMismatch": {
          "type": "string",
          "enum": [
            "lenient",
            "strict"
          ],
          "default": "lenient",
          "description": "记录长度与 copybook 总长度不一致时：lenient=尽量拆分并标出差异；strict=不拆分，只显示整条正文。"
        },
        "rdwViewer.binaryEndian": {
          "type": "string",
          "enum": [
            "big",
            "little"
          ],
          "default": "big",
          "description": "COMP / BINARY（二进制）字段的字节序。COMP-3（packed decimal）不受影响。"
        },
        "rdwViewer.hiddenFieldPattern": {
          "type": "string",
          "default": "^FILLER$",
          "description": "「隐藏字段」开关生效时，字段名匹配该正则（不区分大小写）的列会被隐藏，例如 FILLER|COMMA。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "tsc -p . && node --test out/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
