{
  "name": "rdw-viewer",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.4.1",
  "publisher": "zhuuchaofan",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhuuchaofan/vscode-rdw-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/zhuuchaofan/vscode-rdw-viewer/issues"
  },
  "homepage": "https://github.com/zhuuchaofan/vscode-rdw-viewer#readme",
  "keywords": [
    "cobol",
    "rdw",
    "copybook",
    "comp-3",
    "packed decimal",
    "shift_jis",
    "variable length record",
    "mainframe",
    "COPY句"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "rdwViewer.open",
        "title": "%command.open%"
      },
      {
        "command": "rdwViewer.compare",
        "title": "%command.compare%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "rdwViewer.open",
          "when": "!explorerResourceIsFolder",
          "group": "navigation@100"
        },
        {
          "command": "rdwViewer.compare",
          "when": "!explorerResourceIsFolder",
          "group": "navigation@101"
        }
      ],
      "commandPalette": [
        {
          "command": "rdwViewer.open",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "rdwViewer.encoding": {
          "type": "string",
          "default": "shift_jis",
          "description": "%config.encoding%"
        },
        "rdwViewer.lengthMismatch": {
          "type": "string",
          "enum": [
            "lenient",
            "strict"
          ],
          "default": "lenient",
          "description": "%config.lengthMismatch%"
        },
        "rdwViewer.binaryEndian": {
          "type": "string",
          "enum": [
            "big",
            "little"
          ],
          "default": "big",
          "description": "%config.binaryEndian%"
        },
        "rdwViewer.comp5Endian": {
          "type": "string",
          "enum": [
            "followBinaryEndian",
            "big",
            "little"
          ],
          "default": "little",
          "description": "%config.comp5Endian%"
        },
        "rdwViewer.floatFormat": {
          "type": "string",
          "enum": [
            "ieee",
            "ibm"
          ],
          "default": "ieee",
          "description": "%config.floatFormat%"
        },
        "rdwViewer.autoDetectPacked": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoDetectPacked%"
        },
        "rdwViewer.exportEncoding": {
          "type": "string",
          "enum": [
            "shift_jis",
            "utf-8-bom"
          ],
          "default": "shift_jis",
          "description": "%config.exportEncoding%"
        },
        "rdwViewer.hiddenFieldPattern": {
          "type": "string",
          "default": "^FILLER$",
          "description": "%config.hiddenFieldPattern%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "tsc -p . && node --test out/test/*.test.js",
    "package": "vsce package",
    "examples": "tsc -p . && node out/test/fixtures/write-examples.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "4.1.1",
    "ovsx": "1.4.0",
    "typescript": "^5.4.0"
  }
}
